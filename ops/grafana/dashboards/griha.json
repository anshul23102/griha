  {
   "id": 5,
   "title": "Median engine stage time (income)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le)(rate(griha_stage_seconds_bucket{stage=\"income\"}[5m])))",
     "legendFormat": "p50",
     "instant": true
